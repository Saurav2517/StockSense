# Copy to .env.local (git-ignored; never commit real values). Restart `npm run dev` after editing.
#
# Supabase dashboard → Project Settings → API Keys.
#   VITE_SUPABASE_URL       = "Project URL"  (SUPABASE_URL in the dashboard snippet)
#   VITE_SUPABASE_ANON_KEY  = the PUBLISHABLE key (sb_publishable_...) — or the legacy "anon public" JWT
#
# NEVER put the secret key (sb_secret_...), the service_role key or the JWKS URL here:
# everything in this file is shipped to the browser. The app refuses to start with a secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
